# Template for Datadog RUM browser telemetry (copied to .env.production for
# deployed builds, or .env.local to test locally). Without these the RUM SDK
# stays disabled and the app runs telemetry-free. Create a RUM application in
# the Datadog org to obtain the application ID and public client token.
VITE_DD_RUM_APPLICATION_ID=
VITE_DD_RUM_CLIENT_TOKEN=
# Optional: lets Datadog manage SDK settings (Replay sample rate, privacy)
# remotely without redeploying.
VITE_DD_RUM_REMOTE_CONFIG_ID=
VITE_DD_SITE=datadoghq.eu
VITE_DD_ENV=prod
# Optional release tag on RUM events (e.g. the current user-data release).
#VITE_DD_VERSION=0.0.5
# Set to false to ship a build with the RUM SDK disabled entirely (e.g. while
# the Datadog plan is paused). The SDK is also fail-safe on its own: a refused
# Datadog org only drops events and never affects the app.
VITE_DD_RUM_ENABLED=true
