# Template for Datadog RUM browser telemetry.
#
# Where the values live:
# - Deployed builds read .env.production (committed). The client token is
#   public by design, so committing it is what lets Render build with zero
#   dashboard config — a gitignored file would never reach the Docker build.
#   Rotate values there.
# - .env (gitignored) is for LOCAL overrides only, e.g. pointing a local
#   build at a test RUM application or disabling the SDK. It never reaches
#   Render.
# - The SDK only initializes in production builds: `npm run dev` is
#   telemetry-free even with values present. Test locally with
#   `npm run build && npm run preview`.
#
# Create a RUM application in the Datadog org to obtain the application ID
# and public client token. The Datadog API key never belongs in the frontend.
VITE_DD_RUM_APPLICATION_ID=
VITE_DD_RUM_CLIENT_TOKEN=
# Optional: lets Datadog manage SDK settings (Replay sample rate, privacy)
# remotely without redeploying.
VITE_DD_RUM_REMOTE_CONFIG_ID=
VITE_DD_SITE=datadoghq.eu
VITE_DD_ENV=prod
# Optional release tag on RUM events (e.g. the current user-data release).
#VITE_DD_VERSION=0.0.5
# Set to false to ship a build with the RUM SDK disabled entirely (e.g. while
# the Datadog plan is paused). The SDK is also fail-safe on its own: a refused
# Datadog org only drops events and never affects the app.
VITE_DD_RUM_ENABLED=true
