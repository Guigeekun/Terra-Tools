# Copy to .env (gitignored) — docker compose reads this file automatically.
# Never commit the real .env.

# --- Datadog (docker-compose.yml "datadog" service) ---
# Required for the agent to start; without it the agent exits and the
# rest of the stack keeps running.
DD_API_KEY=
# Datadog intake site, e.g. datadoghq.eu (default) or datadoghq.com
DD_SITE=datadoghq.eu

# --- Backend APM (applied to the terra-tools service) ---
# Traces/profiling flow to the agent over its shared Unix sockets; they are
# only emitted when DD_TRACE_ENABLED=true.
DD_TRACE_ENABLED=true
DD_PROFILING_ENABLED=true
DD_ENV=production
DD_VERSION=0.0.5

# --- user-data fetch behaviour ---
# auto (default): fetch from GitHub releases only when missing
# force-download: always replace user-data with the latest release
BUILD_MODE=auto
